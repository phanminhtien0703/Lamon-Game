# Chặn IP truy cập toàn bộ website
<RequireAll>
    Require all granted
    Require not ip 171.243.48.91
</RequireAll>

RewriteEngine On

# Redirect cũ sang mới: Nhất Mộng Phù Sinh -> Nhất Kiếm Phù Sinh
RewriteRule ^games/nhat-mong-phu-sinh/?(.*)$ /games/nhat-kiem-phu-sinh/$1 [R=301,L]

# Chuyển link .html sang link đẹp
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Cho phép truy cập không cần .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]