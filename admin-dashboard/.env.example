# Email của Service Account trong Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-reader@your-project-id.iam.gserviceaccount.com

# Khóa bí mật Private Key (giữ nguyên \n hoặc dấu ngoặc kép)
